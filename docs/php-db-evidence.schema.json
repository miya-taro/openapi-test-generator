{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-tester.local/schemas/php-db-evidence.schema.json",
  "title": "api-tester PHP database evidence candidates",
  "type": "object",
  "required": ["format", "schemaVersion", "operations"],
  "properties": {
    "format": { "const": "api-tester.php-db-evidence" },
    "schemaVersion": { "const": 1 },
    "operations": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["tables"],
        "properties": {
          "tables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["table", "action", "columns", "evidence"],
              "properties": {
                "table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "action": { "enum": ["select", "insert", "update", "delete", "upsert", "unknown"] },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["file", "line"],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\u0085\\u2028\\u2029]+$"
                      },
                      "line": { "type": "integer", "minimum": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
