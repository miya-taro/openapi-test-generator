{
  "openapi": "3.1.0",
  "info": {
    "title": "crates.io pagination validation contract subset",
    "version": "1",
    "description": "Human-authored subset of official pagination constraints. Test cases are generated without manual selection."
  },
  "x-source": "https://github.com/rust-lang/crates.io/blob/4e0b627fc8fc16391cbe4139f0c5d3f31e91ce47/src/controllers/helpers/pagination.rs",
  "servers": [
    {
      "url": "https://crates.io"
    }
  ],
  "paths": {
    "/api/v1/crates": {
      "get": {
        "operationId": "listCrates",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crate list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "crates",
                    "meta"
                  ],
                  "properties": {
                    "crates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "total"
                      ],
                      "properties": {
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination parameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "errors"
                  ],
                  "properties": {
                    "errors": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "detail"
                        ],
                        "properties": {
                          "detail": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
