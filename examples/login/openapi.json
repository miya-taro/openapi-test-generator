{
  "openapi": "3.0.3",
  "info": {
    "title": "Login fixture (200/400/401 are provisional)",
    "version": "1.0"
  },
  "components": {
    "securitySchemes": {
      "sessionId": {
        "type": "apiKey",
        "in": "header",
        "name": "auth-key"
      }
    }
  },
  "paths": {
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "fixture-user"
                  },
                  "password": {
                    "type": "string",
                    "example": "fixture-password-only"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fixture assumption",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "created_datetime"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "created_datetime": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Fixture assumption",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Fixture assumption",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/protected": {
      "get": {
        "operationId": "protected",
        "security": [
          {
            "sessionId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Fixture assumption",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Fixture assumption",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
