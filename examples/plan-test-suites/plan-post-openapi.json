                          "type": "string",
                          "format": "date-time"
                        },
                        "profit": {
                          "type": "integer"
                        },
                        "controls": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": [
                              "time",
                              "buy",
                              "sell",
                              "charge",
                              "discharge",
                              "soc",
                              "gen",
                              "suppression"
                            ],
                            "properties": {
                              "time": {
                                "type": "string",
                                "format": "time"
                              },
                              "buy": {
                                "type": "number",
                                "format": "double"
                              },
                              "sell": {
                                "type": "number",
                                "format": "double"
                              },
                              "charge": {
                                "type": "number",
                                "format": "double"
                              },
                              "discharge": {
                                "type": "number",
                                "format": "double"
                              },
                              "soc": {
                                "type": "number",
                                "format": "double"
                              },
                              "gen": {
                                "type": "number",
                                "format": "double"
                              },
                              "suppression": {
                                "type": "number",
                                "format": "double"
                              },
                              "correct_point": {
                                "type": "object",
                                "properties": {
                                  "start_time": {
                                    "type": "string",
                                    "format": "time"
                                  },
                                  "start": {
                                    "type": "object",
                                    "properties": {
                                      "buy": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "sell": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "charge": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "discharge": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "soc": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "gen": {
                                        "type": "number",
                                        "format": "double"
                                      },
                                      "suppression": {
                                        "type": "number",
                                        "format": "double"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
