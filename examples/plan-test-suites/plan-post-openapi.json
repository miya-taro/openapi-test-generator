                "properties": {
                  "site_id": {
                    "type": "integer"
                  },
                  "location_id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "1-1",
                      "2-1"
                    ]
                  },
                  "correct": {
                    "type": "boolean"
                  },
                  "force": {
                    "type": "boolean"
                  },
                  "plans": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "date",
                        "profit",
                        "controls"
                      ],
                      "properties": {
