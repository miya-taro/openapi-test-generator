{
  "openapi": "3.1.0",
  "info": {
    "title": "計画保存（検証用の例）",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/plan/set": {
      "post": {
        "operationId": "setPlan",
        "description": "検証例: site_id優先。enum・配列最小件数は実APIの仕様に合わせて編集する。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
