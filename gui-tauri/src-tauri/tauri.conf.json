{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gui-tauri",
  "version": "0.1.0",
  "identifier": "com.openapi-test-tool.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "openapi-test-gen / openapi-test-run",
        "width": 1080,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
