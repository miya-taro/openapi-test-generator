* {
    font-family: "Yu Gothic UI", "Segoe UI", sans-serif;
    font-size: 10.5pt;
}

QMainWindow, QWidget {
    background-color: #f7f8fa;
    color: #1f2430;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e3e8;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #eef2ff;
    color: #2563eb;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e3e8;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #eef2ff;
    color: #2563eb;
}

QListWidget#navList {
    background-color: #0f172a;
    border: none;
    border-right: 1px solid #1e293b;
    padding: 16px 10px;
    outline: none;
}

QListWidget#navList::item {
    color: #cbd5e1;
    padding: 12px 14px;
    margin-bottom: 4px;
    border-radius: 8px;
    border-left: 3px solid transparent;
    font-weight: 600;
}

QListWidget#navList::item:hover:!selected {
    background-color: #1e293b;
    color: #e2e8f0;
}

QListWidget#navList::item:selected {
    background-color: #1e3a8a;
    color: #ffffff;
    border-left: 3px solid #60a5fa;
}

QWidget#contentWrap {
    background-color: #f7f8fa;
}

QWidget#sharedFieldsHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e3e8;
}

QLabel#introLabel {
    background-color: #eef2ff;
    color: #1e3a8a;
    border: 1px solid #c7d2fe;
    border-left: 4px solid #2563eb;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 500;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c7ccd6;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #9aa1ad;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QTabWidget::pane {
    border: 1px solid #e0e3e8;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6b7280;
    padding: 8px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2563eb;
    border: 1px solid #e0e3e8;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    color: #374151;
}

QLabel {
    color: #374151;
}

QLineEdit {
    background: #ffffff;
    border: 1px solid #d7dbe1;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2563eb;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:read-only {
    background: #f1f2f5;
    color: #6b7280;
}

QLineEdit::placeholder {
    color: #9aa1ad;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #d7dbe1;
    border-radius: 6px;
    padding: 6px 10px;
}

QComboBox:hover {
    border: 1px solid #9aa1ad;
}

QComboBox:focus {
    border: 1px solid #2563eb;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d7dbe1;
    border-radius: 6px;
    selection-background-color: #eef2ff;
    selection-color: #2563eb;
    outline: none;
}

QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #c7d2fe;
    color: #eef2ff;
}

QPushButton#secondaryButton {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #d7dbe1;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton#secondaryButton:hover {
    background-color: #f1f2f5;
}

QPushButton#secondaryButton:disabled {
    color: #a8adb6;
    background-color: #f7f8fa;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #e5e7eb;
    height: 14px;
    text-align: center;
    color: #374151;
    font-weight: 600;
}

QProgressBar::chunk {
    border-radius: 6px;
    background-color: #2563eb;
}

QPlainTextEdit {
    background-color: #0f172a;
    color: #d1d5db;
    border: none;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 9.5pt;
}

QLabel#statusLabel {
    font-weight: 600;
    padding: 2px 0;
}

QLabel#statusLabel[state="ok"] {
    color: #16a34a;
}

QLabel#statusLabel[state="ng"] {
    color: #dc2626;
}

QLabel#statusLabel[state="warn"] {
    color: #d97706;
}

QLabel#statusLabel[state="running"] {
    color: #2563eb;
}
